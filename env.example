# Bengaluru SafeRoute Environment Configuration
APP_HOST=127.0.0.1
APP_PORT=8050
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///bengaluru_saferoute.db

# Geospatial Settings
CORRIDOR_BUFFER_METERS=30.0
PROJECTED_CRS=EPSG:32643
GEOGRAPHIC_CRS=EPSG:4326

# Overpass API / OSM Rate Limiting (seconds between network requests)
OSM_REQUEST_DELAY=2.0
OSM_TIMEOUT=30
